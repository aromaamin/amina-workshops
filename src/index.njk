---
layout: base.njk
title: Авторские художественные мастер-классы
---

<section class="hero home-hero">
  <div class="hero-copy">
  <div class="hero-copy-layout">
    <div class="hero-marker">01</div>

    <div class="hero-copy-content">
      <p class="eyebrow">ВИЗУАЛЬНАЯ КУЛЬТУРА ЧЕРЕЗ ПРАКТИКУ</p>

      <h1 class="home-title">
        <span class="home-title-main">Искусство</span>
        <span class="home-title-accent">как <em>диалог</em></span>
      </h1>

      <p class="lead">
        <span class="home-lead-desktop">История искусства, внимательный взгляд<br>и собственная творческая практика.</span>
        <span class="home-lead-mobile">История искусства, внимательный взгляд<br>и собственная творческая практика.</span>
      </p>

      <a class="button" href="#workshops" id="workshops-button">
        Выбрать мастер-класс
      </a>
    </div>
  </div>
</div>
  <div class="hero-art home-hero-art">
    <img
      src="/assets/amina-workshops-hero-approved-3000.webp"
      alt="Атмосфера художественной мастерской"
    >
  </div>
</section>

<section class="statement" id="about">
  <div class="statement-layout">
    <div class="statement-marker">02</div>

    <p class="statement-text">
      Искусство открывается иначе,<br>
      когда становишься не только зрителем,<br>
      а исследуешь его через
      <em>собственный творческий опыт.</em>
    </p>

    <div class="statement-notes">
      <span>ВДОХНОВЕНИЕ</span>
      <span>ЗНАНИЯ</span>
      <span>ПРАКТИКА</span>
    </div>
  </div>
</section>

<section class="catalogue" id="workshops">
  <div class="catalogue-heading-layout">
  <div class="catalogue-marker">03</div>

  <div class="section-heading">
    <p class="eyebrow">АВТОРСКИЕ МАСТЕР-КЛАССЫ</p>
    <h2>Выберите свой диалог</h2>
  </div>
</div>

  <div class="catalogue-mobile-controls" aria-label="Навигация по мастер-классам">
    <button class="catalogue-arrow catalogue-arrow-prev" type="button" aria-label="Предыдущий мастер-класс" disabled>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 12H5m0 0 6-6m-6 6 6 6"/></svg>
    </button>
    <button class="catalogue-arrow catalogue-arrow-next" type="button" aria-label="Следующий мастер-класс">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14m0 0-6-6m6 6-6 6"/></svg>
    </button>
  </div>

  <div class="cards" aria-label="Мастер-классы — горизонтальная галерея">
  {% for workshop in collections.workshops | sort(false, false, "data.order") %}
    <article class="card">
      <a class="card-image" href="{{ workshop.url }}">
        {% if workshop.data.cover %}
          <img src="{{ workshop.data.cover }}" alt="">
        {% else %}
          <span>Фото мастер-класса</span>
        {% endif %}
      </a>
      <div class="card-body">
        <p class="meta">{{ workshop.data.duration }}{% if workshop.data.price %} · {{ workshop.data.price }}{% endif %}</p>
        <h3><a href="{{ workshop.url }}">{{ workshop.data.title }}</a></h3>
        <p>{{ workshop.data.summary }}</p>
        <p class="status">{{ workshop.data.status }}</p>
        <a class="text-link" href="{{ workshop.url }}">Подробнее →</a>
      </div>
    </article>
  {% endfor %}
  </div>
</section>

<section class="group-workshop" aria-labelledby="group-workshop-title">
  <div class="group-workshop-inner">
    <p class="eyebrow">ИНДИВИДУАЛЬНЫЙ ФОРМАТ</p>
    <h2 id="group-workshop-title">Мастер-класс для вашей компании</h2>
    <p>
      Любой из представленных мастер-классов можно организовать
      отдельно для вашей группы от 6 человек — по предварительной
      договорённости о дате и времени.
    </p>
    <a class="text-link" href="https://wa.me/" target="_blank" rel="noopener noreferrer">
      Обсудить проведение ↗
    </a>
  </div>
</section>

<script>
  const workshopsButton = document.querySelector('#workshops-button');

if (workshopsButton) {
  workshopsButton.addEventListener('click', (e) => {
    e.preventDefault();

    document.querySelector('#workshops')?.scrollIntoView({
      behavior: 'smooth',
      block: 'start'
    });

    history.replaceState(null, '', window.location.pathname);
  });
}

const slider = document.querySelector('.cards');

  if (slider) {
    let isDown = false;
    let startX = 0;
    let startScrollLeft = 0;
    let hasDragged = false;

    slider.addEventListener('dragstart', (e) => {
      e.preventDefault();
    });

    slider.addEventListener('mousedown', (e) => {
      isDown = true;
      hasDragged = false;

      startX = e.pageX;
      startScrollLeft = slider.scrollLeft;

      slider.classList.add('is-dragging');
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDown) return;

      e.preventDefault();

      const distance = e.pageX - startX;

      if (Math.abs(distance) > 4) {
        hasDragged = true;
      }

      slider.scrollLeft = startScrollLeft - distance;
    });

    window.addEventListener('mouseup', () => {
      if (!isDown) return;

      isDown = false;
      slider.classList.remove('is-dragging');
    });

    slider.addEventListener('click', (e) => {
      if (hasDragged) {
        e.preventDefault();
        e.stopPropagation();
        hasDragged = false;
      }
    }, true);

    // Desktop: smooth carousel movement on mouse hover.
    if (window.matchMedia('(min-width: 769px) and (hover: hover) and (pointer: fine)').matches) {
      let hoverActive = false;
      let animationFrame = null;
      let pointerPosition = 0.5;
      let currentSpeed = 0;

      function animateHoverScroll() {
        if (!hoverActive || isDown) {
          currentSpeed = 0;
          animationFrame = null;
          return;
        }

        const maxScroll = slider.scrollWidth - slider.clientWidth;

        if (maxScroll <= 0) {
          animationFrame = null;
          return;
        }

        const distanceFromCenter = (pointerPosition - 0.5) * 2;
        const desiredSpeed =
          Math.abs(distanceFromCenter) < 0.18
            ? 0
            : Math.sign(distanceFromCenter) *
              Math.pow(Math.abs(distanceFromCenter), 1.5) * 5;

        currentSpeed += (desiredSpeed - currentSpeed) * 0.08;

        if (Math.abs(currentSpeed) > 0.01) {
          slider.scrollLeft += currentSpeed;
        }

        animationFrame = requestAnimationFrame(animateHoverScroll);
      }

      slider.addEventListener('mouseenter', () => {
        hoverActive = true;

        if (animationFrame === null) {
          animationFrame = requestAnimationFrame(animateHoverScroll);
        }
      });

      slider.addEventListener('mousemove', (e) => {
        const rect = slider.getBoundingClientRect();
        pointerPosition = Math.max(
          0,
          Math.min(1, (e.clientX - rect.left) / rect.width)
        );

        if (!isDown && animationFrame === null) {
          animationFrame = requestAnimationFrame(animateHoverScroll);
        }
      });

      slider.addEventListener('mouseleave', () => {
        hoverActive = false;
        currentSpeed = 0;
      });

      window.addEventListener('mouseup', () => {
        if (hoverActive && animationFrame === null) {
          animationFrame = requestAnimationFrame(animateHoverScroll);
        }
      });
    }
    // Mobile-only accessible carousel controls; desktop dragging remains unchanged.
    const previousButton = document.querySelector('.catalogue-arrow-prev');
    const nextButton = document.querySelector('.catalogue-arrow-next');
    const mobileCarousel = window.matchMedia('(max-width: 760px)');
    const cards = Array.from(slider.querySelectorAll('.card'));

    function updateCarouselArrows() {
      if (!previousButton || !nextButton) return;
      const maxScroll = Math.max(0, slider.scrollWidth - slider.clientWidth);
      previousButton.disabled = slider.scrollLeft <= 3;
      nextButton.disabled = slider.scrollLeft >= maxScroll - 3;
    }

    function moveCarousel(direction) {
      if (!mobileCarousel.matches || !cards.length) return;
      const current = slider.scrollLeft;
      const positions = cards.map(card => card.offsetLeft - cards[0].offsetLeft);
      let target;
      if (direction > 0) {
        target = positions.find(position => position > current + 5);
        if (target === undefined) target = slider.scrollWidth - slider.clientWidth;
      } else {
        target = positions.slice().reverse().find(position => position < current - 5);
        if (target === undefined) target = 0;
      }
      slider.scrollTo({ left: target, behavior: 'smooth' });
    }

    previousButton?.addEventListener('click', () => moveCarousel(-1));
    nextButton?.addEventListener('click', () => moveCarousel(1));
    slider.addEventListener('scroll', updateCarouselArrows, { passive: true });
    window.addEventListener('resize', updateCarouselArrows);
    updateCarouselArrows();
        
  }
</script>
<script>
  const revealItems = document.querySelectorAll(
  '.catalogue-heading-layout, .cards'
);

  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, {
    threshold: 0.15
  });

  revealItems.forEach((item) => {
  item.classList.add('reveal');

  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      revealObserver.observe(item);
    });
  });
});
const statementItems = document.querySelectorAll(
  '.statement-text, .statement-notes'
);

const statementObserver = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
    if (entry.isIntersecting) {
      entry.target.classList.add('is-visible');
      statementObserver.unobserve(entry.target);
    }
  });
}, {
  threshold: 0.1
});

setTimeout(() => {
  statementItems.forEach((item) => {
    statementObserver.observe(item);
  });
}, 900);
</script>
