---
layout: base.njk
---
<article class="workshop-page">
<div class="workshop-back-wrap">
  <button class="workshop-back" id="workshop-back" type="button">
    <span aria-hidden="true">←</span>
    <span>Назад</span>
  </button>
</div>
  <section class="workshop-hero">
    <div>
      <p class="eyebrow">{{ eyebrow }}</p>
      {% if slug == "impressionists" %}
  <h1 class="special-title">
    <span class="special-title-main">Диалог с</span>
    <span class="special-title-accent">импрессионистами</span>
  </h1>
{% else %}
  <h1>{{ title }}</h1>
{% endif %}
      <p class="lead">{{ summary }}</p>
      <div class="facts">
        {% if duration %}<span>{{ duration }}</span>{% endif %}
        {% if price %}<span>{{ price }}</span>{% endif %}
        {% if status %}<span>{{ status }}</span>{% endif %}
      </div>
      {% if whatsapp %}
      <a class="button" href="{{ whatsapp }}" target="_blank" rel="noopener">Записаться в WhatsApp</a>
      {% endif %}
    </div>
    <div class="hero-art">
      {% if cover %}
        <img src="{{ cover }}" alt="">
      {% else %}
        <span>Здесь будет ваша фотография</span>
      {% endif %}
    </div>
  </section>

  <section class="workshop-about">
  <div class="workshop-about-layout">

    <div class="workshop-about-label">
      <span>О мастер-классе</span>
    </div>

    <div class="workshop-about-main">
      <div class="workshop-about-text">
        {{ content | safe }}
      </div>

    </div>

  </div>
</section>
{% if program %}
<section class="workshop-detail">
  <div class="workshop-detail-layout">
    <div class="workshop-detail-label">
      <span>Как проходит встреча</span>
    </div>

    <div class="workshop-detail-text">
      {{ program | safe }}
    </div>
  </div>
</section>
{% endif %}

{% if takeaway %}
<section class="workshop-detail">
  <div class="workshop-detail-layout">
    <div class="workshop-detail-label">
      <span>Что вы унесёте с собой</span>
    </div>

    <div class="workshop-detail-text">
      {{ takeaway | safe }}
    </div>
  </div>
</section>
{% endif %}
<div class="workshop-includes">
  {% if duration %}<span>{{ duration }}</span><i>•</i>{% endif %}
  <span>лекция-презентация</span>
  <i>•</i>
  <span>живопись на холсте</span>
  <i>•</i>
  <span>профессиональные материалы</span>
  <i>•</i>
  <span>индивидуальное сопровождение</span>
  <i>•</i>
  <span>напитки и угощения</span>
</div>
{% if gallery and gallery.length %}
<section class="workshop-gallery">
  <div class="workshop-gallery-head">
    <span class="workshop-gallery-label">Галерея</span>
  </div>

  <div class="workshop-gallery-grid">
    {% for image in gallery %}
  <figure class="workshop-gallery-item workshop-gallery-item-{{ loop.index }}">
    <button
      class="workshop-gallery-open"
      type="button"
      data-full="{{ image }}"
      aria-label="Открыть фотографию крупнее"
    >
      <img src="{{ image }}" alt="" loading="lazy">
    </button>
  </figure>
{% endfor %}
  </div>
</section>
<div class="workshop-lightbox" aria-hidden="true">
  <button
    class="workshop-lightbox-close"
    type="button"
    aria-label="Закрыть"
  >
    ×
  </button>

  <button
  class="workshop-lightbox-prev"
  type="button"
  aria-label="Предыдущая фотография"
>
  ‹
</button>

<button
  class="workshop-lightbox-next"
  type="button"
  aria-label="Следующая фотография"
>
  ›
</button>
  <img class="workshop-lightbox-image" src="" alt="">
</div>
{% endif %}
</article>
<script>
const workshopBack = document.querySelector('#workshop-back');

if (workshopBack) {
  workshopBack.addEventListener('click', () => {
    const referrer = document.referrer;

    if (referrer) {
      try {
        const previousUrl = new URL(referrer);

        if (previousUrl.origin === window.location.origin) {
          history.back();
          return;
        }
      } catch (error) {}
    }

    window.location.href = '/';
  });
}
  const galleryButtons = Array.from(
    document.querySelectorAll('.workshop-gallery-open')
  );

  const lightbox = document.querySelector('.workshop-lightbox');
  const lightboxImage = document.querySelector('.workshop-lightbox-image');
  const lightboxClose = document.querySelector('.workshop-lightbox-close');
  const lightboxPrev = document.querySelector('.workshop-lightbox-prev');
  const lightboxNext = document.querySelector('.workshop-lightbox-next');

  let currentImageIndex = 0;

  if (
    galleryButtons.length &&
    lightbox &&
    lightboxImage &&
    lightboxClose &&
    lightboxPrev &&
    lightboxNext
  ) {
    const showImage = (index) => {
      currentImageIndex =
        (index + galleryButtons.length) % galleryButtons.length;

      const fullImage =
        galleryButtons[currentImageIndex].dataset.full;

      if (fullImage) {
        lightboxImage.src = fullImage;
      }
    };

    const openLightbox = (index) => {
      showImage(index);

      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      lightboxImage.src = '';
      document.body.style.overflow = '';
    };

    galleryButtons.forEach((button, index) => {
      button.addEventListener('click', () => {
        openLightbox(index);
      });
    });

    lightboxPrev.addEventListener('click', (event) => {
      event.stopPropagation();
      showImage(currentImageIndex - 1);
    });

    lightboxNext.addEventListener('click', (event) => {
      event.stopPropagation();
      showImage(currentImageIndex + 1);
    });

    lightboxClose.addEventListener('click', (event) => {
      event.stopPropagation();
      closeLightbox();
    });

    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (!lightbox.classList.contains('is-open')) return;

      if (event.key === 'Escape') {
        closeLightbox();
      }

      if (event.key === 'ArrowLeft') {
        showImage(currentImageIndex - 1);
      }

      if (event.key === 'ArrowRight') {
        showImage(currentImageIndex + 1);
      }
    });
  }
</script>
