---
layout: base.njk
---
<article class="workshop-page">
  <section class="workshop-hero">
    <div>
      <p class="eyebrow">{{ eyebrow }}</p>
      {% if slug == "impressionists" %}
  <h1 class="special-title">
    <span class="special-title-main">Диалог с</span>
    <span class="special-title-accent">импрессионистами</span>
  </h1>
{% else %}
  <h1>{{ title }}</h1>
{% endif %}
      <p class="lead">{{ summary }}</p>
      <div class="facts">
        {% if duration %}<span>{{ duration }}</span>{% endif %}
        {% if price %}<span>{{ price }}</span>{% endif %}
        {% if status %}<span>{{ status }}</span>{% endif %}
      </div>
      {% if whatsapp %}
      <a class="button" href="{{ whatsapp }}" target="_blank" rel="noopener">Записаться в WhatsApp</a>
      {% endif %}
    </div>
    <div class="hero-art">
      {% if cover %}
        <img src="{{ cover }}" alt="">
      {% else %}
        <span>Здесь будет ваша фотография</span>
      {% endif %}
    </div>
  </section>

  <section class="workshop-about">
  <div class="workshop-about-layout">

    <div class="workshop-about-label">
      <span>О мастер-классе</span>
    </div>

    <div class="workshop-about-main">
      <div class="workshop-about-text">
        {{ content | safe }}
      </div>

      <div class="workshop-includes">
        {% if duration %}<span>{{ duration }}</span>{% endif %}
        <span>лекция-презентация</span>
        <span>живопись на холсте</span>
        <span>профессиональные материалы</span>
        <span>индивидуальное сопровождение</span>
        <span>напитки и угощения</span>
      </div>
    </div>

  </div>
</section>
{% if program %}
<section class="workshop-detail">
  <div class="workshop-detail-layout">
    <div class="workshop-detail-label">
      <span>Как проходит встреча</span>
    </div>

    <div class="workshop-detail-text">
      {{ program | safe }}
    </div>
  </div>
</section>
{% endif %}

{% if takeaway %}
<section class="workshop-detail">
  <div class="workshop-detail-layout">
    <div class="workshop-detail-label">
      <span>Что вы унесёте с собой</span>
    </div>

    <div class="workshop-detail-text">
      {{ takeaway | safe }}
    </div>
  </div>
</section>
{% endif %}
{% if gallery and gallery.length %}
<section class="workshop-gallery">
  <div class="workshop-gallery-head">
    <span class="workshop-gallery-label">Галерея</span>
  </div>

  <div class="workshop-gallery-grid">
    {% for image in gallery %}
  <figure class="workshop-gallery-item workshop-gallery-item-{{ loop.index }}">
    <button
      class="workshop-gallery-open"
      type="button"
      data-full="{{ image }}"
      aria-label="Открыть фотографию крупнее"
    >
      <img src="{{ image }}" alt="" loading="lazy">
    </button>
  </figure>
{% endfor %}
  </div>
</section>
<div class="workshop-lightbox" aria-hidden="true">
  <button
    class="workshop-lightbox-close"
    type="button"
    aria-label="Закрыть"
  >
    ×
  </button>

  <button
  class="workshop-lightbox-prev"
  type="button"
  aria-label="Предыдущая фотография"
>
  ‹
</button>

<button
  class="workshop-lightbox-next"
  type="button"
  aria-label="Следующая фотография"
>
  ›
</button>
  <img class="workshop-lightbox-image" src="" alt="">
</div>
{% endif %}
</article>
<script>
  const galleryButtons = document.querySelectorAll('.workshop-gallery-open');
  const lightbox = document.querySelector('.workshop-lightbox');
  const lightboxImage = document.querySelector('.workshop-lightbox-image');
  const lightboxClose = document.querySelector('.workshop-lightbox-close');

  if (galleryButtons.length && lightbox && lightboxImage && lightboxClose) {
    const closeLightbox = () => {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      lightboxImage.src = '';
      document.body.style.overflow = '';
    };

    galleryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const fullImage = button.dataset.full;

        if (!fullImage) return;

        lightboxImage.src = fullImage;
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });
    });

    lightboxClose.addEventListener('click', closeLightbox);

    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && lightbox.classList.contains('is-open')) {
        closeLightbox();
      }
    });
  }
</script>
